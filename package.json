{
  "name": "holon-ui",
  "version": "0.0.1",
  "description": "Typed MCP clients for browser views: MCP Apps host bindings and WebMCP tool exposure.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ui.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "holon": {
    "slot": "generated",
    "contractVersion": 1
  },
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.mjs"
    },
    "./app": {
      "types": "./app.d.ts",
      "import": "./app.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    },
    "./build": {
      "types": "./build.d.ts",
      "import": "./build.mjs"
    }
  },
  "files": [
    "runtime.mjs",
    "runtime.d.ts",
    "generated/",
    "README.md",
    "app.js",
    "app.d.ts",
    "react.js",
    "react.d.ts",
    "state.js",
    "state.d.ts",
    "build.mjs",
    "build.d.ts",
    "src/browser.tsx",
    "src/host.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "holon-sh": "^0.0.1-dev.2",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.60.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
