{
  "name": "holon-ui",
  "version": "0.0.1",
  "description": "Typed MCP clients for browser pages: one connect() for MCP Apps views and WebMCP pages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ui.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./runtime": {
      "types": "./runtime.d.ts",
      "mcp-app": "./runtime.host.mjs",
      "default": "./runtime.web.mjs"
    }
  },
  "files": [
    "runtime.d.ts",
    "runtime.host.mjs",
    "runtime.web.mjs",
    "legacy.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 tests/*.test.mjs && node --conditions=mcp-app --test --test-timeout=30000 tests/mcp-app/*.test.mjs",
    "fixtures": "node scripts/fixtures.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "holon-sh": "^0.0.1-dev.23"
  },
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "zod": "4.6.6"
  }
}
